<Window x:Class="SubtitlesFree.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubtitlesFree — 视频转 SRT 字幕" Height="720" Width="980"
        WindowStartupLocation="CenterScreen" MinHeight="600" MinWidth="820"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: 拖拽/选择区 -->
        <Border x:Name="DropBorder" Grid.Row="0" AllowDrop="True" BorderBrush="#888" BorderThickness="2"
                CornerRadius="8" Padding="24" Margin="0,0,0,10"
                Drop="OnDrop" DragOver="OnDragOver" Background="#F7F7F7">
            <StackPanel>
                <TextBlock Text="拖入 MP4 视频，或点击选择" FontSize="18" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding VideoInfo}" HorizontalAlignment="Center"
                           Foreground="Gray" Margin="0,6,0,0"/>
                <Button Content="选择视频…" Command="{Binding BrowseCommand}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" Padding="16,4"/>
            </StackPanel>
        </Border>

        <!-- 1: 环境状态条（汇总 + 逐项 ✅/✗ + 缺项修复提示，spec §6） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="检测环境" Command="{Binding CheckEnvCommand}"
                        Padding="12,3"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding EnvItems}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" Margin="0,2,8,2" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#5C9E5C"/>
                                    <Setter Property="Background" Value="#E6F4E6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                            <Setter Property="Background" Value="#FDECEA"/>
                                            <Setter Property="BorderBrush" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✅ "/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="False">
                                                        <Setter Property="Text" Value="❌ "/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" MaxWidth="280"
                                           Foreground="#B03A2E" FontSize="12" Margin="18,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 2: 设置 -->
        <Expander Grid.Row="2" Header="设置（模型 / 语言 / 热词 / Python）" Margin="0,0,0,10">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="模型："/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ModelOptions}"
                          SelectedItem="{Binding Model}" Margin="0,2,12,2"/>
                <Label Grid.Row="0" Grid.Column="2" Content="语言："/>
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,2,0,2"
                          SelectedValuePath="Tag" SelectedValue="{Binding LanguageMode}">
                    <ComboBoxItem Content="中文" Tag="zh"/>
                    <ComboBoxItem Content="中英双语" Tag="bilingual"/>
                </ComboBox>

                <Label Grid.Row="1" Grid.Column="0" Content="精度："/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ComputeTypeOptions}"
                          SelectedItem="{Binding ComputeType}" Margin="0,2,12,2"/>
                <Label Grid.Row="1" Grid.Column="2" Content="镜像："/>
                <CheckBox Grid.Row="1" Grid.Column="3" Content="模型下载国内加速"
                          IsChecked="{Binding UseMirror}" VerticalAlignment="Center"
                          ToolTip="模型文件默认从 huggingface.co 下载，国内直连经常失败；勾选后改走 hf-mirror.com 镜像站。&#10;按 README 用 ModelScope 手动下载过模型的话，本项无影响，可保持勾选。"/>

                <!-- 热词组：下拉选组（末位「（不使用热词）」）+ 增删；编辑框绑定当前组，改动即存 -->
                <Label Grid.Row="2" Grid.Column="0" Content="热词组："/>
                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="＋新增组" Command="{Binding AddHotwordSetCommand}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="新建一份热词组（按领域命名），建完直接编辑内容"/>
                        <Button Content="删除" Command="{Binding DeleteHotwordSetCommand}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="删除当前选中的热词组（有确认提示）"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding HotwordSetItems}"
                              SelectedItem="{Binding SelectedHotwordSet}" DisplayMemberPath="Name"
                              ToolTip="按领域维护多份热词，生成时用选中组的词纠正专有名词"/>
                </DockPanel>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="60"
                         Text="{Binding HotwordsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,2"
                         IsEnabled="{Binding HasActiveHotwordSet}"
                         ToolTip="当前组的专有名词，空格、逗号或换行分隔均可，纠正同音错字；改动自动保存到该组"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Python："/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="一般留空。仅当「检测环境」提示找不到 Python 时，才把 python.exe 的完整路径填到这里（例：C:\Users\你\AppData\Local\Programs\Python\Python311\python.exe）" Margin="0,2,0,2"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Foreground="Gray" FontSize="12"
                           Text="转写引擎基于 Python（按 README「快速开始」①②步安装）。留空即可：应用会自动使用装好依赖的 Python，不需要手动填写。"
                           TextWrapping="Wrap" Margin="0,0,0,2"/>

                <!-- 断句参数：MAX_CHARS / ABSORB_CHARS，透传引擎 segmentation.py -->
                <Label Grid.Row="6" Grid.Column="0" Content="断句："/>
                <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="单条最多字数" VerticalAlignment="Center"/>
                    <TextBox Width="44" Margin="4,0,16,0"
                             Text="{Binding MaxChars, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="字幕单条的字数上限（不含空格），超出时在标点/停顿处断开。&#10;默认 18 = B站单行安全宽度；调大（22~27）条更长更完整但可能折行，调小切得更碎。"/>
                    <TextBlock Text="尾部并入字数" VerticalAlignment="Center"/>
                    <TextBox Width="44" Margin="4,0,0,0"
                             Text="{Binding AbsorbChars, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="断句后剩余不超过此字数时并入前一条，避免出现孤字尾（如「…完/事」）。&#10;默认 4；0 = 关闭并入。与「单条最多字数」相加即实际字数硬顶。"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Foreground="Gray" FontSize="12"
                           Text="单条最多字数：每条字幕的字数上限，超出时在标点/停顿处断开（默认 18）；尾部并入字数：断句后剩余不超过该字数时并入前一条，避免孤字尾（默认 4）"
                           TextWrapping="Wrap" Margin="0,0,0,2"/>

                <!-- F3：large-v3-turbo 无翻译引擎，双语时英文行为中文回写（只警告不禁选） -->
                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="⚠ large-v3-turbo 不支持中→英翻译，英文行将为中文回写；双语请切 large-v3"
                           Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BilingualTurboWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Expander>

        <!-- 3: 进度/日志/预览 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" Margin="2" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CCC"/>
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter Property="Background" Value="#FFF3C4"/>
                                            <Setter Property="BorderBrush" Value="#E6A700"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Background" Value="#E6F4E6"/>
                                            <Setter Property="BorderBrush" Value="#5C9E5C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Title}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ProgressBar Grid.Row="1" Height="18" Margin="0,8,0,8"
                         Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"/>

            <Expander Grid.Row="2" Header="日志" IsExpanded="False">
                <TextBox Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas"
                         Background="#111" Foreground="#DDD" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True" Height="140"
                         VerticalScrollBarVisibility="Auto"/>
            </Expander>

            <!-- 完成态三要素：SRT 路径 + 打开文件夹按钮（底部）+ 预览（spec §6） -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
                <TextBlock Text="{Binding SrtPath, StringFormat=字幕已生成：{0}}" FontWeight="Bold"
                           Foreground="#2E7D32" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SrtPath}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Preview}" FontFamily="Consolas"
                           TextWrapping="Wrap" Foreground="#333"/>
            </StackPanel>
        </Grid>

        <!-- 4: 底部按钮 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="取消" Command="{Binding CancelCommand}"
                    Padding="16,5" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="生成字幕" Command="{Binding GenerateCommand}"
                    Padding="20,5" FontWeight="Bold" IsEnabled="{Binding CanGenerate}"/>
            <Button DockPanel.Dock="Left" Content="打开 SRT 所在文件夹"
                    Command="{Binding OpenFolderCommand}"/>
        </DockPanel>
    </Grid>
</Window>
